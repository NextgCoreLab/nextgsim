# nextgsim-gnb - 5G gNodeB Simulator (pre-built binary)
# Base images are pinned by digest so a release is reproducible (#420). To bump: 
# `docker buildx imagetools inspect <tag>` and replace the digest.
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libsctp1 \
    && rm -rf /var/lib/apt/lists/*

COPY binaries/nr-gnb /usr/local/bin/

RUN mkdir -p /etc/nextgsim
WORKDIR /etc/nextgsim

EXPOSE 38412/sctp
EXPOSE 2152/udp
EXPOSE 4997

ENV RUST_LOG=info

ENTRYPOINT ["nr-gnb"]
CMD ["-c", "/etc/nextgsim/gnb.yaml"]
