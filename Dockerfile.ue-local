# nextgsim-ue - 5G UE Simulator (pre-built binary)
# Base images are pinned by digest so a release is reproducible (#420). To bump: 
# `docker buildx imagetools inspect <tag>` and replace the digest.
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

RUN apt-get update && apt-get install -y \
    ca-certificates \
    iputils-ping \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# nr-cli too when the build provides it (the [i] glob matches nothing, rather
# than failing, when binaries/nr-cli is absent); nr-ue-deregister needs it (#365).
COPY binaries/nr-ue binaries/nr-cl[i] /usr/local/bin/
COPY scripts/nr-ue-deregister.sh /usr/local/bin/nr-ue-deregister

RUN mkdir -p /etc/nextgsim
WORKDIR /etc/nextgsim

EXPOSE 4997

ENV RUST_LOG=info

ENTRYPOINT ["nr-ue"]
CMD ["-c", "/etc/nextgsim/ue.yaml"]
